# Copy to backup/restic.env and restrict it: chmod 600 backup/restic.env
# These secrets never enter Git. The app's .env and generated config are
# encrypted by Restic and backed up separately.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_REPOSITORY=s3:s3.us-east-005.backblazeb2.com/REPLACE_WITH_YOUR_BUCKET/media-extract
RESTIC_PASSWORD_FILE=/run/secrets/restic-password
