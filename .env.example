# Copy to .env and fill in your VPN provider credentials.
PUID=1000
PGID=1000
TZ=America/New_York

# ProtonVPN OpenVPN: use the dedicated OpenVPN/IKEv2 credentials from
# https://account.proton.me/u/0/vpn/OpenVpn, not your Proton account password.
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
OPENVPN_PROTOCOL=udp
SERVER_COUNTRIES=United States

# Leave these off for the initial connection. Enabling port forwarding requires
# a Proton plan that supports it and a matching qBittorrent configuration.
VPN_PORT_FORWARDING=off
PORT_FORWARD_ONLY=off

QBITTORRENT_PORT=8080
TORRENTING_PORT=6881
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
JELLYFIN_PORT=8096
MAKEMKV_PORT=5800
HANDBRAKE_PORT=5801

# Linux optical drive device paths; find these with scripts/find-optical-drive.sh.
DVD_DEVICE=/dev/sr0
DVD_SG_DEVICE=/dev/sg0
